#!/usr/bin/env bash

# 1. Set the default value first
RECENT_COMMITTERS_DAYS=7

ERR_NOT_GIT_REPO="Error: Not a git repository"
ERR_INVALID_DAYS="Error: Number of days must be a positive integer"

if ! git rev-parse --is-inside-work-tree > /dev/null 2>&1; then
    >&2 echo "$ERR_NOT_GIT_REPO"
    exit 1
fi

# 2. Check if the user actually typed an argument
if [[ -n "$1" ]]; then
    
    # 3. Since they typed something, verify it is a valid number
    if ! [[ "$1" =~ ^[0-9]+$ ]]; then
        >&2 echo "$ERR_INVALID_DAYS"
        exit 1
    fi
    
    # 4. If it passed the check, overwrite the default with their number
    RECENT_COMMITTERS_DAYS="$1"
fi

# ... (Your validation checks for $1 and git repo go here) ...

echo "Recent committers in the last $RECENT_COMMITTERS_DAYS days:"

# 1. Run the Git command and save the output into a variable
commit_data=$(git shortlog -s -n --since="${RECENT_COMMITTERS_DAYS} days ago")

# 2. Check if the output is empty (no commits in that time frame)
if [[ -z "$commit_data" ]]; then
    echo "No commits found during this period."
else
    # 3. The Required Loop: Feed the variable into a while loop
    echo "$commit_data" | while read -r count name; do
        
        # Inside this loop, you are iterating over the collection!
        # $count holds the number, $name holds the rest of the line.
        
        # You can print it exactly as Git did, or get creative with formatting:
        printf "  %s commits -> %s\n" "$count" "$name"
        
    done
fi