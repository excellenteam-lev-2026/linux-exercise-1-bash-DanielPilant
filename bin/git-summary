#!/usr/bin/env bash

# This script provides a summary of the Git repository, including the total number of commits, the age of the repository, the last active date, and a breakdown of commits by author. It also supports various options for customizing the output.
cd "$(git root)" || { echo "Can't cd to top level directory";exit 1; }

PROJECT_FULL_PATH= # when the --full-path flag is used, the script will display the full path of the project instead of just the project name. This can be useful for distinguishing between multiple repositories that may have the same name but are located in different directories.
SUMMARY_BY_LINE= # when the --line flag is used, the script will provide a summary of the repository based on the number of lines in the specified paths. This can be useful for analyzing the contribution of different authors to specific files or directories within the repository.
DEDUP_BY_EMAIL= # when the --dedup-by-email flag is used, the script will remove duplicate authors who belong to the same email address. This can be useful for consolidating commit counts for authors who may have used different names but the same email address in their commits.
MERGES_ARG= # when the --no-merges flag is used, the script will exclude merge commits from the summary. This can be useful for getting a clearer picture of individual contributions without counting merge commits, which may not represent direct contributions to the codebase.
OUTPUT_STYLE= # when the --output-style flag is used, the script will allow the user to specify the output format for the summary. The user can choose between "tabular" and "oneline" formats, which will affect how the summary information is displayed. The "tabular" format will display the information in a table with columns, while the "oneline" format will display the information in a single line for easier readability.
for arg in "$@"; do # $@ is a special variable in bash that represents all the command-line arguments passed to the script. In this case, it is used to iterate through each argument provided by the user when running the script. The for loop processes each argument and sets the appropriate variables based on the flags provided by the user, allowing for customization of the script's behavior and output format.

# FOUND THE BUG! @args had x as a prefix, but it should be $arg to iterate through the command-line arguments passed to the script. The for loop is designed to process each argument and set the appropriate variables based on the flags provided by the user. By using $arg, we can correctly evaluate each argument and configure the script's behavior accordingly. 
# I have no idea. It seems like a typo or an unfinished thought. I will remove it to clean up the code. 
# (this is what i'll write when i'll be a software engineer in a tech giant in the future)

    case "$arg" in
      # when the --full-path flag is used, the script will display the full path of the project instead of just the project name. This can be useful for distinguishing between multiple repositories that may have the same name but are located in different directories.
        --full-path)
            PROJECT_FULL_PATH=1
            ;;
      # when the --line flag is used, the script will provide a summary of the repository based on the number of lines in the specified paths. This can be useful for analyzing the contribution of different authors to specific files or directories within the repository.
        --line)
            SUMMARY_BY_LINE=1
            ;;
      # when the --dedup-by-email flag is used, the script will remove duplicate authors who belong to the same email address. This can be useful for consolidating commit counts for authors who may have used different names but the same email address in their commits.
        --dedup-by-email) 
            DEDUP_BY_EMAIL=1
            ;;
      # when the --no-merges flag is used, the script will exclude merge commits from the summary. This can be useful for getting a clearer picture of individual contributions without counting merge commits, which may not represent direct contributions to the codebase.
        --no-merges) 
            MERGES_ARG="--no-merges"
            ;;
      # when the --output-style flag is used, the script will allow the user to specify the output format for the summary. The user can choose between "tabular" and "oneline" formats, which will affect how the summary information is displayed. The "tabular" format will display the information in a table with columns, while the "oneline" format will display the information in a single line for easier readability.
        --output-style) 
            OUTPUT_STYLE="$2"
            shift
            ;;
        -*)
      # prints the error message "unknown argument $arg found" to standard error and exits the script with a status code of 1. This is used to handle any unrecognized command-line arguments that are passed to the script, ensuring that the user is informed of any invalid options and preventing the script from running with unintended behavior.
            >&2 echo "unknown argument $arg found"
            exit 1
            ;;
        *)
      # the set -- "$@" "$arg" command is used to update the positional parameters of the script with the remaining arguments after processing the known flags. This allows the script to handle any additional arguments that may be passed by the user, such as specific paths or commit references, while still maintaining the ability to process the known flags correctly.
            set -- "$@" "$arg"
            ;;
    esac

    shift
done

# -n: checks if the length of the string is non-zero. In this case, it is used to check if the SUMMARY_BY_LINE variable has been set, which indicates that the user has requested a summary based on lines rather than commits. If SUMMARY_BY_LINE is set, the script will proceed with generating a summary based on lines; otherwise, it will generate a summary based on commits.
if [ -n "$DEDUP_BY_EMAIL" ] && [ -n "$SUMMARY_BY_LINE" ]; then
    >&2 echo "--dedup-by-email used with --line is not supported"
    exit 1
fi

if [ -n "$MERGES_ARG" ] && [ -n "$SUMMARY_BY_LINE" ]; then
    >&2 echo "--no-merges used with --line is not supported"
    exit 1
fi

commit="HEAD"
if [ -n "$SUMMARY_BY_LINE" ]; then
  paths=( "$@" )
else
  [ $# -ne 0 ] && commit=$*
fi

if [[ -n "$PROJECT_FULL_PATH" ]]; then
  project=${PWD/${HOME}/\~}
else
  project=${PWD##*/}
fi

#
# get date for the given <commit>
#
commit_date() {
  # the $1 can be empty
  # shellcheck disable=SC2086
  # the $1 is 
  git log $MERGES_ARG --pretty='format: %ai' "$1" | cut -d ' ' -f 2
}

#
# get active days for the given <commit>
#
active_days() {
  commit_date "$1" | sort -r | uniq | awk '
    { sum += 1 }
    END { print sum }
  '
}

#
# get the commit total
#
commit_count() {
  # shellcheck disable=SC2086
  git rev-list $MERGES_ARG --count "$commit"
}

#
# total file count
#
file_count() {
  git ls-files | wc -l | tr -d ' '
}

#
# remove duplicate authors who belong to the same email address
#
dedup_by_email() {
    # in:
    # 27  luo zexuan <LuoZexuan@xxx.com>
    #  7  罗泽轩 <luozexuan@xxx.com>
    # out:
    # 34 luo zexuan
    LC_ALL=C awk '
    {
        sum += $1
        last_field = tolower($NF)
        if (last_field in emails) {
            emails[last_field] += $1
        } else {
            email = last_field
            emails[email] = $1
            # set commits/email to empty
            $1=$NF=""
            sub(/^[[:space:]]+/, "", $0)
            sub(/[[:space:]]+$/, "", $0)
            name = $0
            if (name in names) {
                # when the same name is associated with existed email,
                # merge the previous email into the later one.
                emails[email] += emails[names[name]]
                emails[names[name]] = 0
            }
            names[name] = email
        }
    }
    END {
        for (name in names) {
            email = names[name]
            printf "%6d\t%s\n", emails[email], name
        }
    }' | sort -rn -k 1
}

#
# list authors
#
format_authors() {
  # a rare unicode character is used as separator to avoid conflicting with
  # author name. However, Linux column utility will escape tab if separator
  # specified, so we do unesaping after it.
  LC_ALL=C awk '
  { args[NR] = $0; sum += $0 }
  END {
    for (i = 1; i <= NR; ++i) {
      printf "%s♪%2.1f%%\n", args[i], 100 * args[i] / sum
    }
  }
  ' | column -t -s♪ | sed "s/\\\x09/\t/g"
}

#
# fetch repository age from oldest commit
#
repository_age() {
  git log --reverse --pretty=oneline --format="%ar" | head -n 1 | LC_ALL=C sed 's/ago//'
}

#
# fetch repository age of the latest commit
#
last_active() {
  git log --pretty=oneline --format="%ar" -n 1
}

#
# list the last modified author for each line
#
single_file() {
  while read -r data
  do
    if [[ $(file "$data") = *text* ]]; then
      git blame --line-porcelain "$data" 2>/dev/null | grep "^author " | LC_ALL=C sed -n 's/^author //p';
    fi
  done
}

current_branch_name() {
  git rev-parse --abbrev-ref HEAD
}

#
# list the author for all file
#
lines() {
  git ls-files -- "$@" | single_file
}

#
# get the number of the lines
#
line_count() {
  lines "$@" | wc -l
}

uncommitted_changes_count() {
  git status --porcelain | wc -l
}


COLUMN_CMD_DELIMTER="¬" # Hopefully, this symbol is not used in branch names... I use it as a separator for columns
SP="$COLUMN_CMD_DELIMTER|"

print_summary_by_line() {
  if [ "$OUTPUT_STYLE" = "tabular" ]; then
    tabular_headers="# Repo $SP Lines"
    echo -e "$tabular_headers\n$project $SP $(line_count "${paths[@]}")" | column -t -s "$COLUMN_CMD_DELIMTER"
  elif [ "$OUTPUT_STYLE" = "oneline" ]; then
    echo "$project / lines: $(line_count "${paths[@]}")"
  elif [ -n "$SUMMARY_BY_LINE" ]; then
    echo
    echo " project     : $project"
    echo " lines       : $(line_count "${paths[@]}")"
    echo " authors     :"
    lines "${paths[@]}" | sort | uniq -c | sort -rn | format_authors
  fi
}

print_summary() {
  if [ "$OUTPUT_STYLE" = "tabular" ]; then
    tabular_headers="# Repo $SP Age $SP Last active $SP Active on $SP Commits $SP Uncommitted $SP Branch"
    echo -e "$tabular_headers\n$project $SP $(repository_age) $SP $(last_active) $SP $(active_days "$commit") days $SP $(commit_count "$commit") $SP $(uncommitted_changes_count) $SP $(current_branch_name)" | column -t -s "$COLUMN_CMD_DELIMTER"
  elif [ "$OUTPUT_STYLE" = "oneline" ]; then
    echo "$project / age: $(repository_age) / last active: $(last_active) / active on $(active_days "$commit") days / commits: $(commit_count "$commit") / uncommitted: $(uncommitted_changes_count) / branch: $(current_branch_name)"
  else
    echo
    echo " project     : $project"
    echo " repo age    : $(repository_age)"
    echo " branch:     : $(current_branch_name)"
    echo " last active : $(last_active)"
    echo " active on   : $(active_days "$commit") days"
    echo " commits     : $(commit_count "$commit")"

    # The file count doesn't support passing a git ref so ignore it if a ref is given
    if [ "$commit" = "HEAD" ]; then
      echo " files       : $(file_count)"
    fi
    echo " uncommitted : $(uncommitted_changes_count)"
    echo " authors     : "
    if [ -n "$DEDUP_BY_EMAIL" ]; then
      # the $commit can be empty
      # shellcheck disable=SC2086
      git shortlog $MERGES_ARG -n -s -e "$commit" | dedup_by_email | format_authors
    else
      # shellcheck disable=SC2086
      git shortlog $MERGES_ARG -n -s "$commit" | format_authors
    fi
  fi
}

if [ -n "$SUMMARY_BY_LINE" ]; then
  print_summary_by_line
else
  print_summary
fi
